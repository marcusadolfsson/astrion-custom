<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Shared-storage access for /sdcard/astrion/dashboard.json. On the HA100
         (Android 8.1) these are classic runtime permissions, requested by
         MainActivity on launch. requestLegacyExternalStorage keeps the raw
         /sdcard path working should this ever run on Android 10. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />

    <!-- Wake the screen on motion (remote lifted/moved). -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Microphone, for voice. The HA100 has a real mic (android.hardware.
         microphone + a MultiMedia1_Capture PCM device); the stock app holds
         this permission as SYSTEM_FIXED. As a normal user app we need it
         granted at runtime - MainActivity asks on launch. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application
        android:name=".AstrionApp"
        android:allowBackup="true"
        android:label="@string/app_name"
        android:requestLegacyExternalStorage="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.Astrion"
        android:usesCleartextTraffic="true">

        <!--
          usesCleartextTraffic is enabled because most local HA instances are
          reached over plain http:// on the LAN (ws://). Remove it if you only
          ever connect over https:// / wss://.
        -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:configChanges="keyboardHidden|orientation|screenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!--
                  HOME + DEFAULT make this app ELIGIBLE to be the launcher. They
                  change nothing by themselves, because Android still uses
                  whatever is set as the preferred home. Installing this build
                  leaves the stock launcher in charge until someone runs
                  "cmd package set-home-activity".
                -->
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
          Screen-off control. Activated once over adb (dpm set-active-admin) and
          persists across reboots; without activation the receiver is inert and
          lockNow() simply throws, which is caught.
        -->
        <receiver
            android:name=".input.SleepAdminReceiver"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:exported="true">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
