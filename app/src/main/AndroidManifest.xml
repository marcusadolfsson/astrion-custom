<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Shared-storage access for /sdcard/astrion/dashboard.json. On the HA100
         (Android 8.1) these are classic runtime permissions, requested by
         MainActivity on launch. requestLegacyExternalStorage keeps the raw
         /sdcard path working should this ever run on Android 10. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />

    <!-- Wake the screen on motion (remote lifted/moved). -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Microphone, for voice. The HA100 has a real mic (android.hardware.
         microphone + a MultiMedia1_Capture PCM device); the stock app holds
         this permission as SYSTEM_FIXED. As a normal user app we need it
         granted at runtime - MainActivity asks on launch. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application
        android:name=".AstrionApp"
        android:allowBackup="true"
        android:label="@string/app_name"
        android:requestLegacyExternalStorage="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.Astrion"
        android:usesCleartextTraffic="true">

        <!--
          usesCleartextTraffic is enabled because most local HA instances are
          reached over plain http:// on the LAN (ws://). Remove it if you only
          ever connect over https:// / wss://.
        -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="keyboardHidden|orientation|screenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
