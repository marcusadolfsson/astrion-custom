# Astrion boot hook. Added out-of-tree (a NEW file, no existing service touched)
# so a parse error here is skipped by init, never fatal. All it does is run
# /data/local/tmp/astrion-boot.sh once, after the framework is up.
#
# Runs in the su domain -- the same permissive context adbd-root uses on this
# userdebug build (adbd: --root_seclabel=u:r:su:s0) -- so app_process can reach
# /dev/input for the bridge and setprop/ctl.restart works.
service astrion_boot /system/bin/sh /data/local/tmp/astrion-boot.sh
    class late_start
    user root
    group root system input log
    disabled
    oneshot
    seclabel u:r:su:s0

on property:sys.boot_completed=1
    start astrion_boot
