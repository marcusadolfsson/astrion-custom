# Copy to secrets.properties (gitignored) and fill in what you need.
#
# NOTHING HERE IS REQUIRED FOR A DEBUG BUILD. The app asks for its Home
# Assistant URL and token at runtime, via the setup web server on
# http://<remote-ip>:8099, and stores them in app-private storage — so no
# credential is compiled into the APK. See the README, "Point the app at Home
# Assistant".

# --- Release signing (needed only for ./gradlew assembleRelease) -------------
# Generate a keystore once and KEEP IT: Android only allows in-place updates
# when the new APK is signed with the same key.
#   keytool -genkeypair -keystore release.jks -alias astrion \
#     -keyalg RSA -keysize 2048 -validity 10950
#releaseKeystore=/absolute/path/to/release.jks
#releaseKeystorePassword=
#releaseKeyAlias=astrion
#releaseKeyPassword=

# --- Legacy compile-time credentials (optional, leave blank) ----------------
# Upstream injected these as BuildConfig fields. They're still read as a
# fallback when the app has no stored credentials, but the setup server is the
# supported path — filling these in puts a long-lived token in the binary.
#haUrl=
#haToken=
